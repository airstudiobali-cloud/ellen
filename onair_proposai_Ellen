<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Commercial Proposal — Ellen McDonald | On Air Production Bali</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #C9A96E;
    --gold-light: #E8D5B0;
    --gold-dark: #8B6914;
    --black: #080808;
    --dark: #0F0F0F;
    --dark-2: #161616;
    --dark-3: #1E1E1E;
    --white: #FAF8F5;
    --grey: #9A9A9A;
    --grey-light: #D4D0C8;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: 'Montserrat', sans-serif;
    font-weight: 300;
    line-height: 1.7;
    overflow-x: hidden;
  }

  /* ── GRAIN OVERLAY ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1000;
    opacity: 0.4;
  }

  /* ── COVER ── */
  .cover {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    padding: 80px 40px;
    background: radial-gradient(ellipse 80% 60% at 50% 40%, #1a1208 0%, var(--black) 70%);
    border-bottom: 1px solid rgba(201,169,110,0.2);
  }

  .cover::after {
    content: '';
    position: absolute;
    bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 80px;
    background: linear-gradient(to bottom, var(--gold), transparent);
  }

  .cover-badge {
    font-family: 'Montserrat', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 4px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 48px;
    opacity: 0;
    animation: fadeUp 0.8s 0.2s forwards;
  }

  .cover-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(52px, 8vw, 96px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--white);
    margin-bottom: 8px;
    opacity: 0;
    animation: fadeUp 0.8s 0.4s forwards;
  }

  .cover-title em {
    font-style: italic;
    color: var(--gold);
  }

  .cover-subtitle {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 6px;
    color: var(--grey);
    text-transform: uppercase;
    margin-bottom: 64px;
    opacity: 0;
    animation: fadeUp 0.8s 0.6s forwards;
  }

  .cover-divider {
    width: 80px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold), transparent);
    margin: 0 auto 48px;
    opacity: 0;
    animation: fadeUp 0.8s 0.8s forwards;
  }

  .cover-prepared {
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--grey);
    text-transform: uppercase;
    margin-bottom: 12px;
    opacity: 0;
    animation: fadeUp 0.8s 1s forwards;
  }

  .cover-company {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 500;
    color: var(--gold-light);
    letter-spacing: 1px;
    opacity: 0;
    animation: fadeUp 0.8s 1.1s forwards;
  }

  .cover-tagline {
    font-size: 11px;
    color: var(--grey);
    letter-spacing: 2px;
    margin-top: 8px;
    opacity: 0;
    animation: fadeUp 0.8s 1.2s forwards;
  }

  /* ── SECTIONS ── */
  section {
    padding: 100px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .container-wide {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 48px;
  }

  /* ── SECTION LABEL ── */
  .section-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 5px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .section-label::after {
    content: '';
    flex: 1;
    max-width: 60px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  /* ── HEADINGS ── */
  h1, h2, h3 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 400;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 300;
    line-height: 1.1;
    margin-bottom: 48px;
  }

  .section-title em { font-style: italic; color: var(--gold); }

  /* ── OVERVIEW ── */
  .overview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 48px;
  }

  .overview-block {
    padding: 40px;
    border: 1px solid rgba(201,169,110,0.15);
    background: var(--dark-2);
    position: relative;
  }
  .overview-block::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 40px; height: 2px;
    background: var(--gold);
  }

  .overview-block h3 {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 4px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .overview-block .objective {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-style: italic;
    color: var(--gold-light);
    line-height: 1.4;
  }

  .not-list, .is-list {
    list-style: none;
    margin-top: 16px;
  }

  .not-list li {
    font-size: 13px;
    color: var(--grey);
    padding: 6px 0;
    padding-left: 20px;
    position: relative;
  }
  .not-list li::before {
    content: '✕';
    position: absolute;
    left: 0;
    color: #555;
    font-size: 10px;
  }

  .is-list li {
    font-size: 13px;
    color: var(--grey-light);
    padding: 8px 0;
    padding-left: 24px;
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .is-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-size: 12px;
  }

  /* ── POSITIONING ── */
  .positioning-hero {
    text-align: center;
    padding: 80px 40px;
    background: linear-gradient(135deg, var(--dark-2) 0%, var(--dark-3) 100%);
    border: 1px solid rgba(201,169,110,0.2);
    margin-bottom: 64px;
    position: relative;
    overflow: hidden;
  }
  .positioning-hero::before {
    content: '"';
    position: absolute;
    top: -20px; left: 30px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 200px;
    color: rgba(201,169,110,0.06);
    line-height: 1;
  }

  .positioning-hero .name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 56px;
    font-weight: 300;
    font-style: italic;
    color: var(--gold-light);
    margin-bottom: 16px;
  }
  .positioning-hero .role {
    font-size: 11px;
    letter-spacing: 5px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 32px;
  }
  .positioning-hero .desc {
    font-size: 16px;
    color: var(--grey-light);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.8;
  }

  /* ── BRAND PILLARS ── */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 48px;
  }

  .pillar {
    padding: 32px 24px;
    background: var(--dark-2);
    text-align: center;
    transition: background 0.3s;
    cursor: default;
  }
  .pillar:hover { background: var(--dark-3); }

  .pillar-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 48px;
    font-weight: 300;
    color: rgba(201,169,110,0.2);
    line-height: 1;
    margin-bottom: 12px;
  }
  .pillar-name {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
    color: var(--gold-light);
    text-transform: uppercase;
  }

  /* ── MARKET ── */
  .market-quote {
    text-align: center;
    margin: 64px 0;
  }
  .market-quote blockquote {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 48px);
    font-style: italic;
    color: var(--white);
    line-height: 1.3;
    max-width: 700px;
    margin: 0 auto;
  }
  .market-quote .arrow {
    font-size: 24px;
    color: var(--gold);
    margin: 24px 0;
  }
  .market-quote .into {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 500;
    color: var(--gold);
    max-width: 700px;
    margin: 0 auto;
  }

  .segments-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .segment {
    padding: 40px;
    border: 1px solid rgba(255,255,255,0.06);
    background: var(--dark-2);
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .segment-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px;
    font-weight: 300;
    color: rgba(201,169,110,0.25);
    line-height: 1;
    flex-shrink: 0;
    width: 60px;
  }
  .segment-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .segment-desc {
    font-size: 13px;
    color: var(--grey);
    line-height: 1.6;
  }

  /* ── MARKET LEADERS ── */
  .leaders-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 48px;
  }

  .leader-card {
    padding: 40px 32px;
    background: var(--dark-2);
    border-top: 2px solid transparent;
    transition: border-color 0.3s;
  }
  .leader-card:hover { border-color: var(--gold); }

  .leader-platform {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .leader-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    color: var(--white);
    margin-bottom: 24px;
  }

  .leader-stats {
    list-style: none;
  }
  .leader-stats li {
    font-size: 12px;
    color: var(--grey);
    padding: 6px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .leader-stats li::before {
    content: '●';
    color: var(--gold);
    font-size: 6px;
    flex-shrink: 0;
  }

  /* ── CONTENT SYSTEM ── */
  .content-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .content-type {
    padding: 48px 40px;
    border: 1px solid rgba(255,255,255,0.06);
    background: var(--dark-2);
    position: relative;
    overflow: hidden;
  }

  .content-type::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(to right, var(--gold), transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s;
  }
  .content-type:hover::after { transform: scaleX(1); }

  .content-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 72px;
    font-weight: 300;
    color: rgba(201,169,110,0.12);
    line-height: 1;
    margin-bottom: 16px;
  }

  .content-type h3 {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .content-type .format {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--white);
    margin-bottom: 24px;
    line-height: 1.3;
  }

  .content-output {
    font-size: 32px;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 4px;
  }

  .content-output-label {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--grey);
    text-transform: uppercase;
  }

  .content-style {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .content-style li {
    font-size: 12px;
    color: var(--grey);
    padding: 4px 0;
    padding-left: 16px;
    position: relative;
    list-style: none;
  }
  .content-style li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--gold-dark);
  }

  /* ── PACKAGES ── */
  .packages {
    background: var(--dark-2);
  }

  .packages-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 64px;
  }

  .package {
    padding: 64px 56px;
    background: var(--dark-3);
    position: relative;
  }

  .package-01 {
    border-top: 3px solid rgba(201,169,110,0.3);
  }

  .package-02 {
    border-top: 3px solid var(--gold);
    background: linear-gradient(160deg, #17130d 0%, var(--dark-3) 100%);
  }

  .package-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 4px;
    color: var(--grey);
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .package-02 .package-tag { color: var(--gold); }

  .package-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 400;
    color: var(--white);
    margin-bottom: 32px;
    line-height: 1.2;
  }

  .package-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 72px;
    font-weight: 300;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 4px;
  }

  .package-period {
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--grey);
    text-transform: uppercase;
    margin-bottom: 48px;
  }

  .package-divider {
    height: 1px;
    background: rgba(255,255,255,0.06);
    margin: 32px 0;
  }

  .package-section-title {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 16px;
    margin-top: 32px;
  }

  .package-list {
    list-style: none;
  }

  .package-list li {
    font-size: 13px;
    color: var(--grey-light);
    padding: 7px 0;
    padding-left: 20px;
    position: relative;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  .package-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-size: 11px;
  }

  .package-badge {
    display: inline-block;
    padding: 6px 16px;
    background: var(--gold);
    color: var(--black);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .package-note {
    margin-top: 32px;
    padding: 20px 24px;
    border-left: 2px solid var(--gold);
    background: rgba(201,169,110,0.05);
  }
  .package-note p {
    font-size: 12px;
    color: var(--grey);
    line-height: 1.6;
  }
  .package-note strong { color: var(--gold-light); }

  /* ── FINAL ── */
  .final-section {
    text-align: center;
    padding: 120px 40px;
    background: radial-gradient(ellipse 70% 50% at 50% 50%, #1a1208 0%, var(--black) 70%);
  }

  .final-not {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--grey);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .final-as {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(18px, 2.5vw, 26px);
    color: #555;
    text-decoration: line-through;
    text-decoration-color: #444;
    margin-bottom: 40px;
  }

  .final-but {
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .final-statement {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 4vw, 52px);
    font-style: italic;
    color: var(--white);
    line-height: 1.3;
    max-width: 700px;
    margin: 0 auto 64px;
  }

  .final-statement em { color: var(--gold); }

  .final-divider {
    width: 60px;
    height: 1px;
    background: var(--gold);
    margin: 0 auto 48px;
    opacity: 0.4;
  }

  .final-company {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--gold-light);
    letter-spacing: 2px;
  }

  .final-url {
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--grey);
    margin-top: 8px;
    text-transform: lowercase;
  }

  /* ── STRATEGY BANNER ── */
  .strategy-banner {
    padding: 80px 48px;
    background: linear-gradient(135deg, #0f0c07 0%, #1a140a 50%, #0f0c07 100%);
    border-top: 1px solid rgba(201,169,110,0.2);
    border-bottom: 1px solid rgba(201,169,110,0.2);
    margin: 48px 0;
    text-align: center;
  }

  .strategy-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px;
    font-weight: 300;
    color: var(--white);
    margin-bottom: 40px;
  }

  .strategy-pillars {
    display: flex;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
  }

  .s-pillar {
    padding: 20px 32px;
    border-right: 1px solid rgba(201,169,110,0.15);
    text-align: center;
  }
  .s-pillar:last-child { border-right: none; }

  .s-pillar-icon {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--gold);
    text-transform: uppercase;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .overview-grid,
    .segments-grid,
    .content-grid,
    .packages-grid,
    .leaders-grid,
    .pillars-grid { grid-template-columns: 1fr; }
    .container, .container-wide { padding: 0 24px; }
    section { padding: 60px 0; }
    .package { padding: 40px 32px; }
  }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--black); }
  ::-webkit-scrollbar-thumb { background: var(--gold-dark); }

  /* ── COVER WITH PHOTO ── */
  .cover-with-photo {
    position: relative;
    overflow: hidden;
  }
  .cover-photo-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cover-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: brightness(0.25) saturate(0.6);
  }
  .cover-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(8,8,8,0.3) 0%, rgba(8,8,8,0.6) 50%, rgba(8,8,8,0.95) 100%);
  }
  .cover-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* ── EPISODE MOCKUP ── */
  .episode-mockup-wrap {
    max-width: 1100px;
    margin: 0 auto;
  }

  .episode-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #0a0805;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(201,169,110,0.25);
    box-shadow: 0 40px 100px rgba(0,0,0,0.8), 0 0 0 1px rgba(201,169,110,0.1);
    display: flex;
  }

  .ep-topbar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 32px;
    background: rgba(0,0,0,0.7);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    z-index: 10;
  }
  .ep-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
  }
  .ep-dot.red { background: #FF5F57; }
  .ep-dot.yellow { background: #FFBD2E; }
